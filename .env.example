# Kopier denne filen til .env og fyll inn dine verdier

# Flask konfigurasjon
SECRET_KEY=change-this-to-a-random-secret-key-in-production
FLASK_ENV=development

# E-post. ANBEFALT i produksjon: Brevo HTTP API (unngår blokkerte SMTP-porter).
# Sett BREVO_API_KEY, så brukes HTTP API automatisk i stedet for SMTP.
BREVO_API_KEY=
MAIL_DEFAULT_SENDER=helene721@gmail.com

# SMTP-fallback (brukes bare hvis BREVO_API_KEY ikke er satt)
MAIL_SERVER=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-brevo-smtp-login
MAIL_PASSWORD=your-brevo-smtp-key

# App innstillinger
REMINDER_CHECK_INTERVAL=300
NOTIFICATION_ADVANCE_MINUTES=15

# Push-varsler (VAPID) — generer nye nøkler med generate_vapid_keys.py.
# ALDRI commit private nøkler. Sett disse som miljøvariabler i Railway.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_SUB=mailto:helene721@gmail.com

# Datalagring: pek på et Railway Volume i produksjon (f.eks. /app/data) for
# at data skal overleve redeploy. Default er den lokale 'data'-mappen.
DATA_DIR=data

# Kanonisk base-URL (brukes i canonical-tag, og:image, e-postlenker, robots).
# Sett denne hvis du bytter domene, f.eks. https://smartreminder.up.railway.app.
# Hvis den er tom brukes den aktuelle request-verten automatisk.
APP_URL=

# Sett til true KUN på en ikke-HTTPS staging-boks (ellers alltid Secure cookies).
# DISABLE_SECURE_COOKIES=false
